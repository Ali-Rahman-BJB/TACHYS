[Desktop Entry]
Type=Application
Name=Tachys
Comment=Portable Diagnostic Toolkit
# %k = lokasi file .desktop ini sendiri (disisipkan otomatis oleh file manager).
# Dari situ kita ambil folder-nya, lalu jalankan Tachys.sh yang ada di folder yang sama.
# Ini supaya TIDAK hardcode path, sama seperti prinsip Tachys.sh.
Exec=bash -c 'P="%k"; P="${P#file://}"; DIR="$(dirname "$P")"; exec bash "$DIR/Tachys.sh"'
Icon=utilities-terminal
Terminal=true
Categories=Utility;
